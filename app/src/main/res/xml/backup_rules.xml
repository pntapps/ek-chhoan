<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto Backup rules for Android 8–11 (API 26–30). Same allow-list as data_extraction_rules.xml:
    DataStore (files/datastore/), family photos (files/photos/) and the AppCompat per-app language record.
-->
<full-backup-content>
    <include domain="file" path="datastore" />
    <include domain="file" path="photos" />
    <include domain="file" path="androidx.appcompat.app.AppCompatDelegate.application_locales_record_file" />
</full-backup-content>
