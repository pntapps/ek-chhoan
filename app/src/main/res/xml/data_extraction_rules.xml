<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ (API 31+) backup and device-to-device transfer rules.
    Only the family setup is backed up so a phone change keeps it (spec §5):
      - files/datastore/  : DataStore preferences (family list, settings, salted picture-lock hash)
      - files/photos/     : downscaled family photos copied from the Photo Picker
      - AppCompat per-app language record (only written on Android 8–12, autoStoreLocales)
    Everything else (caches, Coil image cache, no_backup) stays excluded because "include" is an allow-list.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore" />
        <include domain="file" path="photos" />
        <include domain="file" path="androidx.appcompat.app.AppCompatDelegate.application_locales_record_file" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore" />
        <include domain="file" path="photos" />
        <include domain="file" path="androidx.appcompat.app.AppCompatDelegate.application_locales_record_file" />
    </device-transfer>
</data-extraction-rules>
